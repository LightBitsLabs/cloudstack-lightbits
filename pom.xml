<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lightbitslabs.cloudstack</groupId>
    <artifactId>cloud-plugin-storage-volume-lightbits</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Apache CloudStack Plugin - Storage Volume Lightbits</name>
    <description>CloudStack managed primary storage plugin for Lightbits NVMe/TCP block storage</description>
    <url>https://github.com/LightBitsLabs/cloudstack-lightbits</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <!-- CloudStack does not publish artifacts to Maven Central: install them
             locally from an apache/cloudstack source checkout at this tag first
             (see README "Building"). -->
        <cloudstack.version>4.22.1.0</cloudstack.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-api</artifactId>
            <version>${cloudstack.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-engine-api</artifactId>
            <version>${cloudstack.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-engine-storage</artifactId>
            <version>${cloudstack.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-engine-storage-volume</artifactId>
            <version>${cloudstack.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-core</artifactId>
            <version>${cloudstack.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-framework-ipc</artifactId>
            <version>${cloudstack.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Agent-side KVM StorageAdaptor classes (KVMStoragePool, QemuImg, Script, ...).
             Provided: shipped by cloudstack-agent; our jar rides its classpath. -->
        <dependency>
            <groupId>org.apache.cloudstack</groupId>
            <artifactId>cloud-plugin-hypervisor-kvm</artifactId>
            <version>${cloudstack.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson is shipped by the CloudStack management server (provided scope: not
             bundled in the plugin jar). Pinned to a patched version to keep the build clean
             of known CVEs; the runtime version is whatever the management server ships. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.10</version>
            <scope>provided</scope>
        </dependency>
        <!-- Pin jackson-core to match databind: the KVM plugin dependency drags an older
             core that lacks StreamConstraintsException, breaking runtime deserialization. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.18.8</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.9.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Quality gate: line coverage >= 60%, enforced on `mvn verify`.
                 (JaCoCo skips the check while no tests exist yet; it becomes a
                 hard gate the moment the first test lands in M1.) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <!-- throw-only SPI stubs are excluded until their M1
                                 implementations land; every class with behavior counts -->
                            <excludes>
                                <exclude>**/storage/datastore/driver/**</exclude>
                                <exclude>**/storage/datastore/lifecycle/**</exclude>
                                <exclude>**/storage/datastore/provider/**</exclude>
                                <!-- agent-side KVM adaptor: exercised by live/Marvin tests,
                                     not unit tests (needs a real host + nvme device) -->
                                <exclude>**/hypervisor/kvm/storage/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
